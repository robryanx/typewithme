{
  "name": "rob/typewithme",
  "description": "Speech-to-text typing practice for kids",
  "type": "project",
  "require": {
    "php": ">=8.2",
    "ext-curl": "*"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "classmap": [
      "api/src/"
    ]
  },
  "autoload-dev": {
    "classmap": [
      "tests/php/"
    ]
  },
  "scripts": {
    "test": "phpunit --colors=always",
    "stan": "phpstan analyse --no-progress",
    "check": [
      "@php -l api/public/index.php",
      "@php -l index.php",
      "@stan",
      "@test"
    ]
  },
  "config": {
    "sort-packages": true
  }
}
